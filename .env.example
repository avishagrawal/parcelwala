# Safe development placeholders only. Copy to .env locally.
APP_NAME=ParcelWalaa API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://parcelwala:parcelwala@db:5432/parcelwala
JWT_SECRET_KEY=replace-with-a-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
SEED_ADMIN_EMAIL=admin@parcelwala.local
SEED_ADMIN_PASSWORD=replace-with-a-local-password
